# Evento (valores por defeito do formulário)
LOCAL_JANTAR="Casa da Aldeia"
VALOR_PRESENTE="5€"
DATA_ENTREGA="24/12/2026"
CONTACTO="Maria Fernanda"              # quem esclarece dúvidas (aparece na mensagem)

# Site
LINK_DOMINIO="www.exemplo.eu"          # domínio público onde o site corre
INDICATIVO_PAIS="351"                  # usado quando o telefone tem 9 dígitos
APOIO_PAYPAL=""                        # ex.: https://paypal.me/o_teu_user
APOIO_REVOLUT=""                       # ex.: https://revolut.me/o_teu_user
APOIO_BUYMEACOFFEE=""                  # ex.: https://buymeacoffee.com/o_teu_user

# Ficheiros
DATA_DIR="data"                        # sorteios (NÃO vai para o GitHub)
FICHEIRO_MISSOES="missaoSecreta.json"
FICHEIRO_CONTROLO="ficheiro_controlo.txt"  # quem tirou quem (só tu, como controlador)
FICHEIRO_NOMES="listNames.json"        # só para o modo terminal

# Pré-preencher o formulário com FICHEIRO_NOMES. Só funciona no próprio computador.
# Em servidor público deixa 0 (evita expor nomes e telefones).
CARREGAR_LISTA="0"

# Servidor e segurança
HOST="127.0.0.1"                       # 0.0.0.0 só para testar no telemóvel na mesma rede
TRUST_PROXY="0"                        # 1 só atrás de proxy HTTPS (nginx, Cloudflare)
MAX_SORTEIOS_HORA="20"                 # limite de sorteios criados por IP/hora
APOIO_KOFI=""                          # ex.: https://ko-fi.com/o_teu_user (alternativa a APOIO_BUYMEACOFFEE)
